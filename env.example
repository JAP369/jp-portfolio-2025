# Copy this file to .env.local and fill in your values
# cp env.example .env.local

# ───── Google AdSense ──────────────────────────────────────────────────────
# Sign up at https://adsense.google.com  →  Get Your Publisher ID
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# ── How to add a real ad slot ──────────────────────────────────────────────
# 1. Go to AdSense → Ads → By ad unit → Display ads
# 2. Create new unit, copy the "data-ad-slot" number
# 3. Paste it into the <AdSense slot="..." /> components in app/page.tsx
